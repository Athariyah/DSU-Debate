{
  "name": "react-vite-tailwind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:live": "vite build --mode live-server",
    "preview": "vite preview",
    "serve:local": "vite build && vite preview",
    "backend": "npm --prefix backend run dev",
    "db": "npm --prefix backend run db:local",
    "db:stop": "npm --prefix backend run db:local:stop",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "3.4.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^30.0.1",
    "opentype.js": "^2.0.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "5.0.0"
  }
}
