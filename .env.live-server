# Сборка для хостинга через VS Code Live Server: `npm run build:live`
#
# Live Server — обычный статический сервер, он не умеет проксировать запросы
# (в отличие от `npm run dev`). Поэтому фронтенд обращается к API по полному
# адресу, а backend разрешает такой источник через CORS (см. backend/src/config/env.ts).
#
# Используется только во время сборки — файл читает Vite (`--mode live-server`).
VITE_API_URL=http://127.0.0.1:4000/api
VITE_SOCKET_URL=http://127.0.0.1:4000

# Демо-режим без backend (локальные моки). Для настоящей работы оставьте false.
VITE_USE_MOCKS=false
