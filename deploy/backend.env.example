# ===========================================================================
# DSU Debate — backend на VPS (production)
# ===========================================================================
# Шаблон. deploy/setup.sh копирует его в /etc/dsu-debate/backend.env
# (права 600, владелец root) и подставляет сгенерированные секреты.
# Вручную:  sudo nano /etc/dsu-debate/backend.env && sudo systemctl restart dsu-debate-backend
#
# ВАЖНО: в режиме NODE_ENV=production backend ПРИ ПАДЕНИИ проверяет секреты
# (backend/src/config/env.ts). Без JWT_SECRET >= 32 символов, без явного
# CORS_ORIGIN и с COOKIE_SECURE=false он не запустится.
# ===========================================================================

NODE_ENV=production
PORT=4000

# ---------------------------------------------------------------------------
# База данных: системный PostgreSQL на этом же сервере.
# DATABASE_URL задаёт «внешнюю» БД — встроенный embedded-postgres при этом
# НЕ запускается (см. backend/src/config/database.ts).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://__DB_USER__:__DB_PASSWORD__@127.0.0.1:5432/__DB_NAME__
LOCAL_DATABASE=false
# БД на том же хосте по 127.0.0.1 — TLS не нужен.
DB_SSLMODE=disable
DB_POOL_MAX=20
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=3000

# ---------------------------------------------------------------------------
# Безопасность
# ---------------------------------------------------------------------------
# >= 32 символов, уникальный. Сгенерировать: openssl rand -hex 32
JWT_SECRET=__JWT_SECRET__
JWT_EXPIRES_IN=8h

# Запрос приходит через Caddy (один прокси-хоп) — иначе rate-limit и логи
# будут видеть IP самого Caddy (127.0.0.1), а не посетителей.
TRUST_PROXY=1

# True обязательно в production. При работе по http:// (без домена) браузер
# просто проигнорирует cookie — вход в админку всё равно работает, потому что
# фронтенд хранит JWT в localStorage и шлёт его в заголовке Authorization.
COOKIE_SECURE=true

# Откуда браузеру разрешено обращаться к API. Ровно тот origin, по которому
# открыт сайт (схему и порт included, без слэша в конце). Несколько — через запятую.
CORS_ORIGIN=__SITE_ORIGIN__

# ---------------------------------------------------------------------------
# Администратор (создаётся один раз при первом старте, если его ещё нет)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=__ADMIN_EMAIL__
# В пароле лучше не использовать #, $, % и пробелы: этот файл читают и dotenv,
# и systemd EnvironmentFile, и спецсимволы они трактуют по-разному.
ADMIN_PASSWORD=__ADMIN_PASSWORD__

# Самостоятельную регистрацию админов на публичном сервере не включаем.
ALLOW_ADMIN_REGISTRATION=false
ADMIN_REGISTRATION_KEY=__ADMIN_REGISTRATION_KEY__
