# Docker Compose variables
NODE_ENV=development
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@dsu.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_REGISTRATION_KEY=local-registration-key
# Comma-separated allowed origins, or * to allow any (development only;
# production requires an explicit list).
CORS_ORIGIN=*
TRUST_PROXY=1
COOKIE_SECURE=false

# Frontend variables for a standalone Vite dev server
VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_BACKEND_URL=http://localhost:4000
VITE_USE_MOCKS=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# By default the container uses its BUILT-IN PostgreSQL
# (postgresql://dsu:dsu@127.0.0.1:5432/dsu_debate).
#
# To use the Amvera managed PostgreSQL (CNPG) instead, set either a full
# connection string or the separate variables, and switch off the built-in
# server with EMBEDDED_POSTGRES=false.
#
# Internal Amvera domain (app deployed in Amvera):
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@amvera-athariyyah-cnpg-dsu-debatedb-rw:5432/<DB>
#
# External domain (connection from the internet — SSL is required):
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@dsu-debatedb-athariyyah.db-msk0.amvera.tech:5432/<DB>?sslmode=require
#
# Separate variables (handy when the password is stored as a secret):
# DB_HOST=amvera-athariyyah-cnpg-dsu-debatedb-rw
# DB_PORT=5432
# DB_NAME=<DB>
# DB_USER=<USER>
# DB_PASSWORD=<PASSWORD>
DB_SSLMODE=
DB_POOL_MAX=20
EMBEDDED_POSTGRES=true
