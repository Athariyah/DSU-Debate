# ===========================================================================
# DSU Debate — переменные окружения ФРОНТЕНДА (корень репозитория)
# ===========================================================================
# Этот файл читает Vite (и dev-сервер, и сборка).
# Порядок локального запуска описан в README.md / docs/LOCAL_HOSTING.md:
#
#   1. cd backend && npm install && npm run dev   — API + PostgreSQL на этом ПК
#   2. npm run build:live                         — сборка для Live Server
#
# Настройки самого backend и локальной БД — в backend/.env.example
# (backend читает свой файл `backend/.env`).

# Как фронтенд обращается к API.
#   /api                       — относительный путь: работает через прокси
#                                `npm run dev` / `npm run preview` (рекомендуется
#                                для режима разработки);
#   http://127.0.0.1:4000/api  — полный адрес: нужен для VS Code Live Server,
#                                который прокси не умеет. Именно это значение
#                                подставляет `npm run build:live`
#                                (см. .env.live-server).
VITE_API_URL=/api

# Адрес Socket.io. Пусто = тот же хост, что и страница (работает через прокси).
# Для Live Server укажите полный адрес: http://127.0.0.1:4000
VITE_SOCKET_URL=

# Куда dev-сервер/предпросмотр проксирует /api и /socket.io.
VITE_BACKEND_URL=http://127.0.0.1:4000

# Демонстрационный режим без backend (данные из src/mock). Оставьте false,
# если хотите работать с настоящей базой.
VITE_USE_MOCKS=false
