{
  "name": "dsu-debate-backend",
  "version": "1.0.0",
  "private": true,
  "description": "DSU Debate — Express + Socket.io + PostgreSQL backend с встроенной локальной БД",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:check": "tsx src/db/check-cli.ts",
    "db:local": "tsx src/localdb/cli.ts start",
    "db:local:stop": "tsx src/localdb/cli.ts stop",
    "db:local:restart": "tsx src/localdb/cli.ts restart",
    "db:local:status": "tsx src/localdb/cli.ts status",
    "db:local:doctor": "tsx src/localdb/cli.ts doctor",
    "db:local:logs": "tsx src/localdb/cli.ts logs",
    "admin:list": "tsx src/db/admin-cli.ts list",
    "admin:add": "tsx src/db/admin-cli.ts add",
    "admin:reset": "tsx src/db/admin-cli.ts reset",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "embedded-postgres": "17.10.0-beta.17",
    "express": "5.2.1",
    "express-rate-limit": "7.5.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.12.0",
    "socket.io": "4.8.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.9",
    "@types/pg": "8.11.6",
    "ts-node-dev": "2.0.0",
    "tsx": "4.20.6",
    "typescript": "5.5.3"
  }
}
