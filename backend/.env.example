# ===========================================================================
# DSU Debate — BACKEND + ВСТРОЕННАЯ ЛОКАЛЬНАЯ БД
# ===========================================================================
# Скопируйте файл в backend/.env (он в .gitignore) и меняйте значения при
# необходимости:
#
#   cp backend/.env.example backend/.env        # Linux / macOS
#   copy backend\.env.example backend\.env      # Windows (cmd)
#
# Всё, что ниже, имеет рабочие значения по умолчанию: без этого файла
# приложение всё равно запустится (в режиме разработки) и поднимет
# PostgreSQL на этом компьютере.
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Встроенный PostgreSQL (на этом компьютере)
# ---------------------------------------------------------------------------
# PostgreSQL не нужно устанавливать: бинарники приходят с npm-зависимостью
# embedded-postgres. Кластер создаётся один раз в backend/.localdb и слушает
# только 127.0.0.1 — в локальную сеть база не открывается.
#
#   auto (по умолчанию) — использовать встроенную БД, если внешняя не задана;
#   false               — не запускать её (нужен DATABASE_URL / DB_HOST).
LOCAL_DATABASE=auto

# Каталог с данными и логами (абсолютный путь или относительно backend/).
# На Windows лучше держать путь латиницей и без пробелов.
# LOCAL_DB_DIR=C:\dsu-localdb

# Порт и реквизиты локального сервера. 55432 выбран, чтобы не конфликтовать
# с уже установленным PostgreSQL на стандартном 5432.
LOCAL_DB_PORT=55432
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres
LOCAL_DB_NAME=dsu_debate

# Каталог bin уже установленного PostgreSQL — если не хочется использовать
# скачанные бинарники (например, на Windows ARM64 или при запрете запуска
# скачанных .exe антивирусом).
# LOCAL_DB_BIN_DIR=C:\Program Files\PostgreSQL\17\bin

# Сколько ждать инициализацию/запуск локальной БД, мс.
LOCAL_DB_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Внешняя БД (необязательно)
# ---------------------------------------------------------------------------
# Если задать DATABASE_URL или DB_HOST, встроенный PostgreSQL запускаться не
# будет — приложение станет работать с указанной базой.
#
# DATABASE_URL=postgresql://dsu:dsu@localhost:5432/dsu_debate
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dsu_debate
# DB_USER=dsu
# DB_PASSWORD=dsu
#
# TLS (libpq-семантика): disable | allow | prefer | require | verify-ca | verify-full.
# Пусто = disable для localhost и prefer для удалённого хоста.
DB_SSLMODE=
# DB_SSL_CA=C:\certs\root.crt
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=3000
DB_POOL_MAX=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------------
# Безопасность и админ
# ---------------------------------------------------------------------------
# В режиме разработки, если JWT_SECRET не задан, используется значение
# «dev-only-secret». В production обязателен свой секрет ≥ 32 символов.
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=8h

# Откуда браузеру разрешено обращаться к API.
#
# По умолчанию (пока эта переменная не задана) в режиме разработки разрешены
# ЛЮБЫЕ источники: сайт можно открыть через VS Code Live Server (в том числе по
# IP в локальной сети), через Vite, туннель или превью-домен — и всё работает
# без настройки. Политика печатается в логе backend строкой «CORS: ...».
#
# Чтобы ограничить доступ, задайте список через запятую:
# CORS_ORIGIN=http://127.0.0.1:5500,http://192.168.1.42:5500
#
# `*` — любые источники. В production значение по умолчанию не используется:
# там требуется явный список, а `*` вызывает ошибку при старте.
# CORS_ORIGIN=*

# За прокси (nginx и т.п.) укажите число хопов; при локальном запуске 0.
TRUST_PROXY=0
COOKIE_SECURE=false

# Локальный администратор создаётся один раз при первом старте, если его нет.
# Значения по умолчанию (режим разработки): admin@dsu.local / ChangeMe123!
# Смените пароль перед публикацией в интернет.
ADMIN_EMAIL=admin@dsu.local
ADMIN_PASSWORD=ChangeMe123!

# Самостоятельная регистрация админов. Включайте осознанно: включённая
# регистрация с ключом по умолчанию = любой сможет стать админом.
ALLOW_ADMIN_REGISTRATION=false
ADMIN_REGISTRATION_KEY=local-registration-key
