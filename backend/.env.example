NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# Option 1: a full connection string.
DATABASE_URL=postgresql://dsu:dsu@localhost:5432/dsu_debate

# Option 2: separate variables (override DATABASE_URL when DB_HOST is set).
# The password stays outside the URL — convenient for cloud panels/secrets.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dsu_debate
# DB_USER=dsu
# DB_PASSWORD=dsu

# TLS mode (libpq semantics): disable | allow | prefer | require | verify-ca |
# verify-full. Empty = disable for localhost, prefer for a remote host.
# The Amvera external domain requires TLS: use require.
DB_SSLMODE=
# Path to a CA certificate for verify-ca / verify-full.
# DB_SSL_CA=
# Wait for the database on startup (cloud DBs wake up slowly).
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=3000
# Pool size — keep an eye on the connection limit of your managed DB plan.
DB_POOL_MAX=20

# --- Amvera managed PostgreSQL (CNPG) ---------------------------------------
# Internal domain (the app is deployed in Amvera):
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@amvera-athariyyah-cnpg-dsu-debatedb-rw:5432/<DB>
# External domain (access from the internet, TLS required):
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@dsu-debatedb-athariyyah.db-msk0.amvera.tech:5432/<DB>?sslmode=require
# Verify with: npm run db:check

JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0
COOKIE_SECURE=false

# A local admin is created once if absent.
ADMIN_EMAIL=admin@dsu.local
ADMIN_PASSWORD=ChangeMe123!

# Registration is closed in production unless this key is supplied.
ALLOW_ADMIN_REGISTRATION=true
ADMIN_REGISTRATION_KEY=local-registration-key
